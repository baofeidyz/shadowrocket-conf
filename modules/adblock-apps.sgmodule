#!name=广告净化 · 哔哩哔哩/值得买/京东/淘宝/高德
#!desc=配合主配置的域名 REJECT，净化五个常用 App 的开屏、信息流和页面内推广。
#!author=baofeidyz
#!category=去广告
#!system=ios
#!date=2026-11-09
# 仅处理广告和推广；不解锁会员、付费功能、画质、皮肤或去水印。
# 响应脚本来自仍在维护的 zirawell/R-Store AntiAd 目录。

[URL Rewrite]
# ===== 哔哩哔哩 =====
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\? - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? - reject-dict
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v\d\/resource\? - reject-dict

# ===== 高德地图 =====
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\? - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?:car-end|route-plan) - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/shield\/(?:search\/new_hotword|search_poi\/tips_adv)\? - reject-dict
^https?:\/\/oss\.amap\.com\/ws\/banner\/lists\/\? - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/(?:main-page-assets|main-page-location|ridewalk-end-fc) - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/(?:mapapi\/hint_text\/offline_data|message\/notice\/list) - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/shield\/scene\/recommend\? - reject-dict

# ===== 京东 =====
^https?:\/\/\w{32}\.jddebug\.com\/diagnose\? - reject
^https?:\/\/storage\.360buyimg\.com\/(?:app\.m\.jd\.com\/lottie|dynamicConfig\/binary|occupy-home\/|xview|appcartsoa\/client\/cart_egg_entry) - reject
^https?:\/\/img\d+\.360buyimg\.com\/jddjadvertise\/ - reject
^https?:\/\/storage\.jd\.com\/(?:ti-pythontask\/JD\/jdt_|mpaas2-public\/product\/\d+\/) - reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:searchBoxWord|xview2Config|stationPullService|getWidget|widget|hybrid|jdDiscoveryRedPoint|queryMaterialAdverts|apollo_style|jdaPreDownload|uniformRecommend7) - reject-200
^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/ - reject-200

# ===== 淘宝 =====
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash - reject-dict
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise - reject-dict
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv - reject-dict
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit - reject-dict
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get) - reject-dict

# ===== 什么值得买 =====
^https?:\/\/app-api\.smzdm\.com\/util\/loading\? - reject-dict
^https?:\/\/app-api\.smzdm\.com\/mychannel\/list$ - reject-dict
^https?:\/\/user-api\.smzdm\.com\/vip\/bottom_card_list\? - reject-dict
^https?:\/\/article-api\.smzdm\.com\/publish\/get_bubble\? - reject-dict
^https?:\/\/s-api\.smzdm\.com\/sou\/(?:search_default_keyword|popup_coupon)\? - reject-dict

[Script]
# 哔哩哔哩：JSON/Protobuf 广告字段过滤
bilibili_proto_dynamic = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v\d\.Dynamic\/DynAll,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliProtoA.js
bilibili_proto_reply = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.main\.community\.reply\.v\d\.Reply\/MainList,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliProtoA.js
bilibili_proto_search = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.polymer\.app\.search\.v\d\.Search\/SearchAll,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliProtoA.js
bilibili_json_feed = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v\d\/(?:feed\/index(?:\/story)?|search\/square)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliJson.js
bilibili_json_ui = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|show\/tab\/v\d)|v\d\/splash\/(?:brand\/list|event\/list2|list|show))\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliJson.js

# 高德地图：路线、搜索、首页和打车页广告字段过滤
amap_route = type=http-response,pattern=^https?:\/\/m\d\.amap\.com\/ws\/(?:aos\/perception\/publicTravel\/beforeNavi|bus\/plan\/integrate|perception\/drive\/(?:routeInfo|routePlan))\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js
amap_search = type=http-response,pattern=^https?:\/\/m\d\.amap\.com\/ws\/shield\/(?:search\/(?:common\/coupon\/info|poi\/detail|nearbyrec_smart)|search_business\/process\/marketingOperationStructured|search_poi\/(?:homepage|mps|search\/sp|sug|tips_operation_location)),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js
amap_home = type=http-response,pattern=^https?:\/\/m\d\.amap\.com\/ws\/(?:faas\/amap-navigation\/(?:card-service-plan-home|main-page)|shield\/frogserver\/aocs\/updatable\/1|shield\/dsp\/profile\/index\/nodefaasv\d)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js
amap_taxi = type=http-response,pattern=^https?:\/\/m\d-zb\.amap\.com\/ws\/(?:boss\/(?:car\/order\/content_info|order_web\/friendly_information)|promotion-web\/resource(?:\/home)?|sharedtrip\/taxi\/order_detail_car_tips)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js

# 京东、淘宝、什么值得买
jd_ads = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome|readCustomSurfaceList),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/jd.js
# 京东新版搜索将 functionId 放在 POST 请求体，URL 只有 /client.action；使用本仓库保守过滤脚本。
jd_search_ads = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/baofeidyz/shadowrocket-conf/refs/heads/main/scripts/jd-search-ad-filter.js
taobao_splash = type=http-response,pattern=^https?:\/\/(?:guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)|poplayer\.template\.alibaba\.com\/\w+\.json),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/taobao.js
smzdm_ads = type=http-response,pattern=^https?:\/\/(?:haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul|user-api\.smzdm\.com\/vip|app-api\.smzdm\.com\/util\/(?:loading|update)|haojia-api\.smzdm\.com\/(?:home\/list|ranking_list\/articles)|homepage-api\.smzdm\.com\/v\d\/home|article-api\.smzdm\.com\/publish\/get_bubble|qianbao\.smzdm\.com\/v\d\/app\/home|s-api\.smzdm\.com\/sou\/(?:filter\/tags\/hot_tags|list_v\d)|post\.m\.smzdm\.com\/ajax_app\/ajax_get_footer_list),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/smzdm.js

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net, api.bilibili.com, api.live.bilibili.com, upos-sz-static.bilivideo.com, amap-aos-info-nogw.amap.com, m*.amap.com, oss.amap.com, api.m.jd.com, *.jddebug.com, bdsp-x.jd.com, dsp-x.jd.com, storage.360buyimg.com, img*.360buyimg.com, storage.jd.com, acs.m.taobao.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com, app-api.smzdm.com, user-api.smzdm.com, article-api.smzdm.com, s-api.smzdm.com, haojia.m.smzdm.com, haojia-api.smzdm.com, homepage-api.smzdm.com, qianbao.smzdm.com, post.m.smzdm.com
